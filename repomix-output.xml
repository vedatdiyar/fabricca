              </button>
            </div>
          )}
        </div>

        <div className="flex items-start gap-3">
          {isReading ? (
            <BookOpen className="h-4 w-4 text-primary mt-1 shrink-0" />
          ) : (
            <Sparkles className="h-4 w-4 text-accent-foreground mt-1 shrink-0" />
          )}
