import { Textarea } from "@/components/ui/textarea";
import { useMatrixSubmit } from "../../_hooks/use-matrix-submit";

type FormState = {
  subjectProblem: string;
  theoreticalFramework: string;
  primaryMaterial: string;
  methodology: string;
};

type FieldConfig = {
  key: keyof FormState;
  id: string;
  number: string;
  Icon: LucideIcon;
  label: string;
  description: string;
  placeholder: string;
  rows: number;
};

type SectionConfig = {
  id: string;
